<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.aliexpress.mapper.StoresMapper">
    
    <resultMap type="Stores" id="StoresResult">
        <result property="id"    column="id"    />
        <result property="storeManager"    column="store_manager"    />
        <result property="storeName"    column="store_name"    />
    </resultMap>

    <sql id="selectStoresVo">
        select id, store_manager, store_name from stores
    </sql>

    <select id="selectStoresList" parameterType="Stores" resultMap="StoresResult">
        <include refid="selectStoresVo"/>
        <where>  
            <if test="storeManager != null  and storeManager != ''"> and store_manager = #{storeManager}</if>
            <if test="storeName != null  and storeName != ''"> and store_name like concat('%', #{storeName}, '%')</if>
        </where>
    </select>
    
    <select id="selectStoresById" parameterType="Long" resultMap="StoresResult">
        <include refid="selectStoresVo"/>
        where id = #{id}
    </select>

    <insert id="insertStores" parameterType="Stores" useGeneratedKeys="true" keyProperty="id">
        insert into stores
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="storeManager != null">store_manager,</if>
            <if test="storeName != null">store_name,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="storeManager != null">#{storeManager},</if>
            <if test="storeName != null">#{storeName},</if>
         </trim>
    </insert>

    <update id="updateStores" parameterType="Stores">
        update stores
        <trim prefix="SET" suffixOverrides=",">
            <if test="storeManager != null">store_manager = #{storeManager},</if>
            <if test="storeName != null">store_name = #{storeName},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteStoresById" parameterType="Long">
        delete from stores where id = #{id}
    </delete>

    <delete id="deleteStoresByIds" parameterType="String">
        delete from stores where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>