    <select id="selectPofitOrderListWarehouseTotalList" parameterType="PofitOrderListWarehouse" resultMap="PofitOrderListWarehouseResult">
        SELECT
            amol.category,
            -- 总利润
            SUM(COALESCE(amol.actual_profit,0)) AS actual_profit,
            -- 销售数量
            SUM(COALESCE(amol.quantity,0)) AS quantity,
            -- 销售金额
            SUM(COALESCE(amol.loan_amount,0)) AS loan_amount,
            -- 利润率
            SUM(COALESCE(amol.actual_profit,0))/ SUM(COALESCE(amol.loan_amount,0))*100 AS profit_margin
        FROM
        pofit_order_list_warehouse AS amol
        JOIN aliexpress_profit_analysis_table AS apat ON amol.sku=apat.sku
        <where>
        <if test="year != null "> and year = #{year}</if>
        <if test="moon != null "> and moon = #{moon}</if>
        <if test="sku != null  and sku != ''"> and apat.sku like concat('%', #{sku}, '%')</if>
        <if test="category != null "> and category = #{category}</if>
        </where>
        GROUP BY
            amol.category
    </select>


