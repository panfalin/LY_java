    <sql id="selectPofitOrderListWarehouseVo">
        SELECT
            s_id,
            YEAR,
            moon,
            apat.sku,
            quantity,
            actual_profit,
            transit_quantity,
            stock_quantity,
            bd_stock_quantity,
            bc_stock_quantity,
            unshipped_quantity,
            inventory_cost,
            daily_avg_sales,
            loan_amount,
            profit_margin,
            cost_price,
            monthly_return,
            inventory_turns,
            return_rate,
            sale_days,
            sku_state,
            market_capacity,
            category,
            person_charge
        FROM
            pofit_order_list_warehouse AS polw
            JOIN aliexpress_profit_analysis_table AS apat ON polw.sku=apat.sku
    </sql>


