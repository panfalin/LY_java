    <select id="selectAliexpressPublishedDataList" parameterType="AliexpressPublishedData"
            resultMap="AliexpressPublishedDataResult">
        <include refid="selectAliexpressPublishedDataVo"/>
        <where>
            sn.type != "全托管"
            <if test="beginTime != null and endTime != null">
                and d1.statistical_time between #{beginTime} and #{endTime}
            </if>
            <if test="commodityId != null  and commodityId != ''">and d1.commodity_id = #{commodityId}</if>
            <if test="personName != null  and personName != ''">and d1.person_name = #{personName}</if>
            <if test="shopName != null  and shopName != ''">and d1.shop_name = #{shopName}</if>
        </where>
    </select>


    <select id="selectAliexpressPublishedDataStatisticsList" parameterType="AliexpressPublishedData"
            resultMap="AliexpressPublishedDataStatisticsResult">
        <include refid="selectAliexpressPublishedDataStatisticsVo"/>
        <where>
            sn.type != "全托管"
            <if test="beginTime != null and endTime != null">
                and d1.statistical_time between #{beginTime} and #{endTime}
            </if>
            <if test="commodityId != null  and commodityId != ''">and commodity_id = #{commodityId}</if>
            <if test="personName != null  and personName != ''">and person_name = #{personName}</if>
            <if test="shopName != null  and shopName != ''">and shop_name = #{shopName}</if>
        </where>
    </select>




    <select id="selectAliexpressPublishedDataByCommodityId" parameterType="String"
            resultMap="AliexpressPublishedDataResult">
        <include refid="selectAliexpressPublishedDataVo"/>
        where commodity_id = #{commodityId}
    </select>

    <insert id="insertAliexpressPublishedData" parameterType="AliexpressPublishedData">
        insert into aliexpress_published_data
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="commodityId != null">commodity_id,</if>
            <if test="statisticalTime != null">statistical_time,</if>
            <if test="paymentConversion != null">payment_conversion,</if>
            <if test="searchExposure != null">search_exposure,</if>
            <if test="successfulRefund != null">successful_refund,</if>
            <if test="visitors != null">visitors,</if>
            <if test="goodsAdditional != null">goods_additional,</if>
            <if test="goodsCollection != null">goods_collection,</if>
            <if test="searchClicks != null">search_clicks,</if>
            <if test="transactionAmount != null">transaction_amount,</if>
            <if test="pricePay != null">price_pay,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="commodityId != null">#{commodityId},</if>
            <if test="statisticalTime != null">#{statisticalTime},</if>
            <if test="paymentConversion != null">#{paymentConversion},</if>
            <if test="searchExposure != null">#{searchExposure},</if>
            <if test="successfulRefund != null">#{successfulRefund},</if>
            <if test="visitors != null">#{visitors},</if>
            <if test="goodsAdditional != null">#{goodsAdditional},</if>
            <if test="goodsCollection != null">#{goodsCollection},</if>
            <if test="searchClicks != null">#{searchClicks},</if>
            <if test="transactionAmount != null">#{transactionAmount},</if>
            <if test="pricePay != null">#{pricePay},</if>
        </trim>
    </insert>

    <update id="updateAliexpressPublishedData" parameterType="AliexpressPublishedData">
        update aliexpress_published_data
        <trim prefix="SET" suffixOverrides=",">
            <if test="statisticalTime != null">statistical_time = #{statisticalTime},</if>
            <if test="paymentConversion != null">payment_conversion = #{paymentConversion},</if>
            <if test="searchExposure != null">search_exposure = #{searchExposure},</if>
            <if test="successfulRefund != null">successful_refund = #{successfulRefund},</if>
            <if test="visitors != null">visitors = #{visitors},</if>
            <if test="goodsAdditional != null">goods_additional = #{goodsAdditional},</if>
            <if test="goodsCollection != null">goods_collection = #{goodsCollection},</if>
            <if test="searchClicks != null">search_clicks = #{searchClicks},</if>
            <if test="transactionAmount != null">transaction_amount = #{transactionAmount},</if>
            <if test="pricePay != null">price_pay = #{pricePay},</if>
        </trim>
        where commodity_id = #{commodityId}
    </update>

    <delete id="deleteAliexpressPublishedDataByCommodityId" parameterType="String">
        delete
        from aliexpress_published_data
        where commodity_id = #{commodityId}
    </delete>

    <delete id="deleteAliexpressPublishedDataByCommodityIds" parameterType="String">
        delete from aliexpress_published_data where commodity_id in
        <foreach item="commodityId" collection="array" open="(" separator="," close=")">
            #{commodityId}
        </foreach>
    </delete>

</mapper>