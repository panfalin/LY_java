        <result property="successfulRefundContrast" column="successful_refund_contrast"/>
        <result property="visitors" column="visitors"/>
        <result property="visitorsContrast" column="visitors_contrast"/>
        <result property="goodsAdditional" column="goods_additional"/>
        <result property="goodsAdditionalContrast" column="goods_additional_contrast"/>
        <result property="goodsCollection" column="goods_collection"/>
        <result property="goodsCollectionContrast" column="goods_collection_contrast"/>
        <result property="searchClicks" column="search_clicks"/>
        <result property="searchClicksContrast" column="search_clicks_contrast"/>
        <result property="transactionAmount" column="transaction_amount"/>
        <result property="transactionAmountContrast" column="transaction_amount_contrast"/>
        <result property="pricePay" column="price_pay"/>
