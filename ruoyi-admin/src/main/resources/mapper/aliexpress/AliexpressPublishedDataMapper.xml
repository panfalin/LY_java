<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.aliexpress.mapper.AliexpressPublishedDataMapper">
    
    <resultMap type="AliexpressPublishedData" id="AliexpressPublishedDataResult">
        <result property="commodityId"    column="commodity_id"    />
        <result property="shopName"    column="shop_name"    />
        <result property="statisticalTime"    column="statistical_time"    />
        <result property="paymentConversion"    column="payment_conversion"    />
        <result property="searchExposure"    column="search_exposure"    />
        <result property="successfulRefund"    column="successful_refund"    />
        <result property="visitors"    column="visitors"    />
        <result property="goodsAdditional"    column="goods_additional"    />
        <result property="goodsCollection"    column="goods_collection"    />
        <result property="searchClicks"    column="search_clicks"    />
        <result property="transactionAmount"    column="transaction_amount"    />
        <result property="pricePay"    column="price_pay"    />
    </resultMap>

    <sql id="selectAliexpressPublishedDataVo">
        select shop_name,commodity_id, statistical_time, payment_conversion, search_exposure, successful_refund, visitors, goods_additional, goods_collection, search_clicks, transaction_amount, price_pay from aliexpress_published_data
    </sql>

    <select id="selectAliexpressPublishedDataList" parameterType="AliexpressPublishedData" resultMap="AliexpressPublishedDataResult">
        <include refid="selectAliexpressPublishedDataVo"/>
        <where>
            <if test="beginTime != null and endTime != null">
                and statistical_time between #{beginTime} and #{endTime}
            </if>
            <if test="commodityId != null  and commodityId != ''"> and commodity_id = #{commodityId}</if>
            <if test="shopName != null  and shopName != ''"> and shop_name = #{shopName}</if>
            <if test="statisticalTime != null "> and statistical_time = #{statisticalTime}</if>
            <if test="paymentConversion != null "> and payment_conversion = #{paymentConversion}</if>
            <if test="searchExposure != null  and searchExposure != ''"> and search_exposure = #{searchExposure}</if>
            <if test="successfulRefund != null "> and successful_refund = #{successfulRefund}</if>
            <if test="visitors != null  and visitors != ''"> and visitors = #{visitors}</if>
            <if test="goodsAdditional != null  and goodsAdditional != ''"> and goods_additional = #{goodsAdditional}</if>
            <if test="goodsCollection != null  and goodsCollection != ''"> and goods_collection = #{goodsCollection}</if>
            <if test="searchClicks != null "> and search_clicks = #{searchClicks}</if>
            <if test="transactionAmount != null "> and transaction_amount = #{transactionAmount}</if>
            <if test="pricePay != null "> and price_pay = #{pricePay}</if>
        </where>
    </select>
    
    <select id="selectAliexpressPublishedDataByCommodityId" parameterType="String" resultMap="AliexpressPublishedDataResult">
        <include refid="selectAliexpressPublishedDataVo"/>
        where commodity_id = #{commodityId}
    </select>

    <insert id="insertAliexpressPublishedData" parameterType="AliexpressPublishedData">
        insert into aliexpress_published_data
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="commodityId != null">commodity_id,</if>
            <if test="statisticalTime != null">statistical_time,</if>
            <if test="paymentConversion != null">payment_conversion,</if>
            <if test="searchExposure != null">search_exposure,</if>
            <if test="successfulRefund != null">successful_refund,</if>
            <if test="visitors != null">visitors,</if>
            <if test="goodsAdditional != null">goods_additional,</if>
            <if test="goodsCollection != null">goods_collection,</if>
            <if test="searchClicks != null">search_clicks,</if>
            <if test="transactionAmount != null">transaction_amount,</if>
            <if test="pricePay != null">price_pay,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="commodityId != null">#{commodityId},</if>
            <if test="statisticalTime != null">#{statisticalTime},</if>
            <if test="paymentConversion != null">#{paymentConversion},</if>
            <if test="searchExposure != null">#{searchExposure},</if>
            <if test="successfulRefund != null">#{successfulRefund},</if>
            <if test="visitors != null">#{visitors},</if>
            <if test="goodsAdditional != null">#{goodsAdditional},</if>
            <if test="goodsCollection != null">#{goodsCollection},</if>
            <if test="searchClicks != null">#{searchClicks},</if>
            <if test="transactionAmount != null">#{transactionAmount},</if>
            <if test="pricePay != null">#{pricePay},</if>
         </trim>
    </insert>

    <update id="updateAliexpressPublishedData" parameterType="AliexpressPublishedData">
        update aliexpress_published_data
        <trim prefix="SET" suffixOverrides=",">
            <if test="statisticalTime != null">statistical_time = #{statisticalTime},</if>
            <if test="paymentConversion != null">payment_conversion = #{paymentConversion},</if>
            <if test="searchExposure != null">search_exposure = #{searchExposure},</if>
            <if test="successfulRefund != null">successful_refund = #{successfulRefund},</if>
            <if test="visitors != null">visitors = #{visitors},</if>
            <if test="goodsAdditional != null">goods_additional = #{goodsAdditional},</if>
            <if test="goodsCollection != null">goods_collection = #{goodsCollection},</if>
            <if test="searchClicks != null">search_clicks = #{searchClicks},</if>
            <if test="transactionAmount != null">transaction_amount = #{transactionAmount},</if>
            <if test="pricePay != null">price_pay = #{pricePay},</if>
        </trim>
        where commodity_id = #{commodityId}
    </update>

    <delete id="deleteAliexpressPublishedDataByCommodityId" parameterType="String">
        delete from aliexpress_published_data where commodity_id = #{commodityId}
    </delete>

    <delete id="deleteAliexpressPublishedDataByCommodityIds" parameterType="String">
        delete from aliexpress_published_data where commodity_id in 
        <foreach item="commodityId" collection="array" open="(" separator="," close=")">
            #{commodityId}
        </foreach>
    </delete>
</mapper>