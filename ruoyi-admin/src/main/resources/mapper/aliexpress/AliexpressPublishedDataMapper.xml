    <resultMap type="AliexpressPublishedDataStatistics" id="AliexpressPublishedDataStatisticsResult">
        <result property="totalSearchExposure" column="total_search_exposure"/>
        <result property="avgSearchExposure" column="avg_search_exposure"/>
        <result property="totalSuccessfulRefund" column="total_successful_refund"/>
        <result property="avgSuccessfulRefund" column="avg_successful_refund"/>
        <result property="totalVisitors" column="total_visitors"/>
        <result property="avgVisitors" column="avg_visitors"/>
        <result property="totalGoodsAdditional" column="total_goods_additional"/>
        <result property="avgGoodsAdditional" column="avg_goods_additional"/>
        <result property="totalGoodsCollection" column="total_goods_collection"/>
        <result property="avgGoodsCollection" column="avg_goods_collection"/>
        <result property="totalTransactionAmount" column="total_transaction_amount"/>
        <result property="avgTransactionAmount" column="avg_transaction_amount"/>
        <result property="totalMainOrdersPaid" column="total_main_orders_paid"/>
        <result property="avgMainOrdersPaid" column="avg_main_orders_paid"/>
        <result property="totalViews" column="total_views"/>
        <result property="avgViews" column="avg_views"/>
    </resultMap>


    <sql id="selectAliexpressPublishedDataVo">
        SELECT d1.shop_name,
               d1.commodity_id,
               d1.statistical_time,
               d1.payment_conversion,
               d1.search_exposure,
               d1.successful_refund,
               d1.visitors,
               d1.goods_additional,
               d1.goods_collection,
               d1.search_clicks,
               d1.transaction_amount,
               d1.price_pay,
               d1.views,
               d1.main_orders_paid,
               d1.person_name,
               -- 计算当前天与前一天的差值（若前一天数据不存在，则默认为0）
               (d1.payment_conversion - IFNULL(d2.payment_conversion, 0)) AS payment_conversion_contrast,
               (d1.search_exposure - IFNULL(d2.search_exposure, 0))       AS search_exposure_contrast,
               (d1.successful_refund - IFNULL(d2.successful_refund, 0))   AS successful_refund_contrast,
               (d1.visitors - IFNULL(d2.visitors, 0))                     AS visitors_contrast,
               (d1.goods_additional - IFNULL(d2.goods_additional, 0))     AS goods_additional_contrast,
               (d1.goods_collection - IFNULL(d2.goods_collection, 0))     AS goods_collection_contrast,
               (d1.search_clicks - IFNULL(d2.search_clicks, 0))           AS search_clicks_contrast,
               (d1.transaction_amount - IFNULL(d2.transaction_amount, 0)) AS transaction_amount_contrast,
               (d1.price_pay - IFNULL(d2.price_pay, 0))                   AS price_pay_contrast,
               (d1.views - IFNULL(d2.views, 0))                           AS views_contrast,
               (d1.main_orders_paid - IFNULL(d2.main_orders_paid, 0))     AS main_orders_paid_contrast
        FROM aliexpress_published_data d1
        LEFT JOIN aliexpress_published_data d2
        ON d1.statistical_time = DATE_ADD(d2.statistical_time, INTERVAL #{interval} DAY) and
        d1.commodity_id = d2.commodity_id
        LEFT JOIN stores_notescrow as sn ON sn.store_name=d1.shop_name
    </sql>


    <sql id="selectAliexpressPublishedDataStatisticsVo">
        SELECT SUM(search_exposure)    AS total_search_exposure,
               AVG(search_exposure)    AS avg_search_exposure,
               SUM(successful_refund)  AS total_successful_refund,
               AVG(successful_refund)  AS avg_successful_refund,
               SUM(visitors)           AS total_visitors,
               AVG(visitors)           AS avg_visitors,
               SUM(goods_additional)   AS total_goods_additional,
               AVG(goods_additional)   AS avg_goods_additional,
               SUM(goods_collection)   AS total_goods_collection,
               AVG(goods_collection)   AS avg_goods_collection,
               SUM(transaction_amount) AS total_transaction_amount,
               AVG(transaction_amount) AS avg_transaction_amount,
               SUM(main_orders_paid)   AS total_main_orders_paid,
               AVG(main_orders_paid)   AS avg_main_orders_paid,
               SUM(views)              AS total_views,
               AVG(views)              AS avg_views
        FROM `aliexpress_published_data` as d1
        LEFT JOIN stores_notescrow as sn ON sn.store_name=d1.shop_name
    </sql>

