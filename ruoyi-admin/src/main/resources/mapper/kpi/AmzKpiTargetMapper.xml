<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.kpi.mapper.AmzKpiTargetMapper">

    <resultMap type="AmzKpiTarget" id="AmzKpiTargetResult">
        <result property="targetId" column="target_id"/>
        <result property="kpiId" column="kpi_id"/>
        <result property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="department" column="department"/>
        <result property="category" column="category"/>
        <result property="categoryIndex" column="category_index"/>
        <result property="metricName" column="metric_name"/>
        <result property="currValue" column="curr_value"/>
