        where target_id = #{targetId}
    </delete>

    <delete id="deleteAmzKpiTargetByTargetIds" parameterType="String">
        delete from amz_kpi_target where target_id in
        <foreach item="targetId" collection="array" open="(" separator="," close=")">
            #{targetId}
        </foreach>
    </delete>
</mapper>