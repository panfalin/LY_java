    <update id="updateAmzKpiTarget" parameterType="AmzKpiTarget">
        update amz_kpi_target
        <trim prefix="SET" suffixOverrides=",">
            <if test="kpiId != null">kpi_id = #{kpiId},</if>
            <if test="userId != null and userId != ''">user_id = #{userId},</if>
            <if test="userName != null and userName != ''">user_name = #{userName},</if>
            <if test="department != null and department != ''">department = #{department},</if>
            <if test="category != null and category != ''">category = #{category},</if>
            <if test="categoryIndex != null">category_index = #{categoryIndex},</if>
            <if test="metricName != null and metricName != ''">metric_name = #{metricName},</if>
            <if test="currValue != null">curr_value = #{currValue},</if>
            <if test="targetValue != null">target_value = #{targetValue},</if>
            <if test="weight != null">weight = #{weight},</if>
            <if test="score != null">score = #{score},</if>
            <if test="calcType != null">calc_type = #{calcType},</if>
            <if test="evaluationCriteria != null">evaluation_criteria = #{evaluationCriteria},</if>
