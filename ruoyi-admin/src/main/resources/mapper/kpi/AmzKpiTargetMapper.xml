    <sql id="selectAmzKpiTargetVo">
        select target_id,
               kpi_id,
               user_id,
               user_name,
               department,
               category,
               category_index,
               metric_name,
               curr_value,
               target_value,
               weight,
               score,
               calc_type,
               evaluation_criteria,
               remark,
               create_time,
               update_time
        from amz_kpi_target
    </sql>

    <select id="selectAmzKpiTargetList" parameterType="AmzKpiTarget" resultMap="AmzKpiTargetResult">
        <include refid="selectAmzKpiTargetVo"/>
        <where>
            <if test="kpiId != null ">and kpi_id = #{kpiId}</if>
            <if test="userId != null  and userId != ''">and user_id = #{userId}</if>
            <if test="userName != null  and userName != ''">and user_name = #{userName}</if>
            <if test="department != null  and department != ''">and department = #{department}</if>
            <if test="category != null  and category != ''">and category = #{category}</if>
            <if test="categoryIndex != null ">and category_index = #{categoryIndex}</if>
            <if test="metricName != null  and metricName != ''">and metric_name = #{metricName}</if>
            <if test="currValue != null ">and curr_value = #{currValue}</if>
            <if test="targetValue != null ">and target_value = #{targetValue}</if>
            <if test="weight != null ">and weight = #{weight}</if>
            <if test="score != null ">and score = #{score}</if>
            <if test="calcType != null  and calcType != ''">and calc_type = #{calcType}</if>
            <if test="evaluationCriteria != null  and evaluationCriteria != ''">and evaluation_criteria =
                #{evaluationCriteria}
            </if>
        </where>
    </select>

    <select id="selectAmzKpiTargetByTargetId" parameterType="Long" resultMap="AmzKpiTargetResult">
        <include refid="selectAmzKpiTargetVo"/>
        where target_id = #{targetId}
    </select>

    <insert id="insertAmzKpiTarget" parameterType="AmzKpiTarget" useGeneratedKeys="true" keyProperty="targetId">
        insert into amz_kpi_target
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="kpiId != null">kpi_id,</if>
            <if test="userId != null and userId != ''">user_id,</if>
            <if test="userName != null and userName != ''">user_name,</if>
            <if test="department != null and department != ''">department,</if>
