<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.task.mapper.AmzTaskTemplateMapper">
    
    <resultMap type="AmzTaskTemplate" id="AmzTaskTemplateResult">
        <result property="templateId"    column="template_id"    />
        <result property="templateName"    column="template_name"    />
        <result property="storeName"    column="store_name"    />
        <result property="metricType"    column="metric_type"    />
        <result property="targetLevel"    column="target_level"    />
        <result property="defaultDuration"    column="default_duration"    />
        <result property="templateConfig"    column="template_config"    />
        <result property="subTargets"    column="sub_targets"    />
        <result property="notifyRules"    column="notify_rules"    />
        <result property="isEnabled"    column="is_enabled"    />
        <result property="isPublic"    column="is_public"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectAmzTaskTemplateVo">
        select template_id, template_name, store_name, metric_type, target_level, default_duration, template_config, sub_targets, notify_rules, is_enabled, is_public, create_by, create_time, update_time from amz_task_template
    </sql>

    <select id="selectAmzTaskTemplateList" parameterType="AmzTaskTemplate" resultMap="AmzTaskTemplateResult">
        <include refid="selectAmzTaskTemplateVo"/>
        <where>  
            <if test="templateName != null  and templateName != ''"> and template_name like concat('%', #{templateName}, '%')</if>
            <if test="storeName != null  and storeName != ''"> and store_name = #{storeName}</if>
            <if test="metricType != null  and metricType != ''"> and metric_type = #{metricType}</if>
            <if test="targetLevel != null  and targetLevel != ''"> and target_level = #{targetLevel}</if>
            <if test="defaultDuration != null "> and default_duration = #{defaultDuration}</if>
            <if test="templateConfig != null  and templateConfig != ''"> and template_config = #{templateConfig}</if>
            <if test="subTargets != null  and subTargets != ''"> and sub_targets = #{subTargets}</if>
            <if test="notifyRules != null  and notifyRules != ''"> and notify_rules = #{notifyRules}</if>
            <if test="isEnabled != null "> and is_enabled = #{isEnabled}</if>
            <if test="isPublic != null "> and is_public = #{isPublic}</if>
        </where>
    </select>
    
    <select id="selectAmzTaskTemplateByTemplateId" parameterType="Long" resultMap="AmzTaskTemplateResult">
        <include refid="selectAmzTaskTemplateVo"/>
        where template_id = #{templateId}
    </select>

    <insert id="insertAmzTaskTemplate" parameterType="AmzTaskTemplate" useGeneratedKeys="true" keyProperty="templateId">
        insert into amz_task_template
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="templateName != null and templateName != ''">template_name,</if>
            <if test="storeName != null">store_name,</if>
            <if test="metricType != null and metricType != ''">metric_type,</if>
            <if test="targetLevel != null and targetLevel != ''">target_level,</if>
            <if test="defaultDuration != null">default_duration,</if>
            <if test="templateConfig != null">template_config,</if>
            <if test="subTargets != null">sub_targets,</if>
            <if test="notifyRules != null">notify_rules,</if>
            <if test="isEnabled != null">is_enabled,</if>
            <if test="isPublic != null">is_public,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="templateName != null and templateName != ''">#{templateName},</if>
            <if test="storeName != null">#{storeName},</if>
            <if test="metricType != null and metricType != ''">#{metricType},</if>
            <if test="targetLevel != null and targetLevel != ''">#{targetLevel},</if>
            <if test="defaultDuration != null">#{defaultDuration},</if>
            <if test="templateConfig != null">#{templateConfig},</if>
            <if test="subTargets != null">#{subTargets},</if>
            <if test="notifyRules != null">#{notifyRules},</if>
            <if test="isEnabled != null">#{isEnabled},</if>
            <if test="isPublic != null">#{isPublic},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateAmzTaskTemplate" parameterType="AmzTaskTemplate">
        update amz_task_template
        <trim prefix="SET" suffixOverrides=",">
            <if test="templateName != null and templateName != ''">template_name = #{templateName},</if>
            <if test="storeName != null">store_name = #{storeName},</if>
            <if test="metricType != null and metricType != ''">metric_type = #{metricType},</if>
            <if test="targetLevel != null and targetLevel != ''">target_level = #{targetLevel},</if>
            <if test="defaultDuration != null">default_duration = #{defaultDuration},</if>
            <if test="templateConfig != null">template_config = #{templateConfig},</if>
            <if test="subTargets != null">sub_targets = #{subTargets},</if>
            <if test="notifyRules != null">notify_rules = #{notifyRules},</if>
            <if test="isEnabled != null">is_enabled = #{isEnabled},</if>
            <if test="isPublic != null">is_public = #{isPublic},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where template_id = #{templateId}
    </update>

    <delete id="deleteAmzTaskTemplateByTemplateId" parameterType="Long">
        delete from amz_task_template where template_id = #{templateId}
    </delete>

    <delete id="deleteAmzTaskTemplateByTemplateIds" parameterType="String">
        delete from amz_task_template where template_id in 
        <foreach item="templateId" collection="array" open="(" separator="," close=")">
            #{templateId}
        </foreach>
    </delete>
</mapper>