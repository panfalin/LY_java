<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.task.mapper.AmzTaskMainMapper">
    
    <resultMap type="AmzTaskMain" id="AmzTaskMainResult">
        <result property="taskId"    column="task_id"    />
        <result property="taskName"    column="task_name"    />
        <result property="taskCode"    column="task_code"    />
        <result property="storeName"    column="store_name"    />
        <result property="sku"    column="sku"    />
        <result property="asin"    column="asin"    />
        <result property="marketplaceId"    column="marketplace_id"    />
        <result property="metricType"    column="metric_type"    />
        <result property="targetLevel"    column="target_level"    />
        <result property="targetValue"    column="target_value"    />
        <result property="currentValue"    column="current_value"    />
        <result property="startTime"    column="start_time"    />
        <result property="endTime"    column="end_time"    />
        <result property="status"    column="status"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectAmzTaskMainVo">
        select task_id, task_name, task_code, store_name, sku, asin, marketplace_id, metric_type, target_level, target_value, current_value, start_time, end_time, status, remark, create_by, create_time, update_by, update_time from amz_task_main
    </sql>

    <select id="selectAmzTaskMainList" parameterType="AmzTaskMain" resultMap="AmzTaskMainResult">
        <include refid="selectAmzTaskMainVo"/>
        <where>  
            <if test="taskName != null  and taskName != ''"> and task_name like concat('%', #{taskName}, '%')</if>
            <if test="taskCode != null  and taskCode != ''"> and task_code = #{taskCode}</if>
            <if test="storeName != null  and storeName != ''"> and store_name like concat('%', #{storeName}, '%')</if>
            <if test="sku != null  and sku != ''"> and sku = #{sku}</if>
            <if test="asin != null  and asin != ''"> and asin = #{asin}</if>
            <if test="marketplaceId != null  and marketplaceId != ''"> and marketplace_id = #{marketplaceId}</if>
            <if test="metricType != null  and metricType != ''"> and metric_type = #{metricType}</if>
            <if test="targetLevel != null  and targetLevel != ''"> and target_level = #{targetLevel}</if>
            <if test="startTime != null "> and start_time = #{startTime}</if>
            <if test="endTime != null "> and end_time = #{endTime}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectAmzTaskMainByTaskId" parameterType="Long" resultMap="AmzTaskMainResult">
        <include refid="selectAmzTaskMainVo"/>
        where task_id = #{taskId}
    </select>
    <select id="selectTaskGroupBySku" resultType="com.ruoyi.task.domain.vo.SkuTaskVO">
        SELECT 
            t.store_name, 
            t.sku, 
            MAX(t.asin) as asin,
            MAX(t.marketplace_id) as marketplace_id,
            COUNT(t.task_id) as taskCount,
            SUM(CASE WHEN t.status = 'running' THEN 1 ELSE 0 END) as runningCount,
            SUM(CASE WHEN t.status = 'completed' THEN 1 ELSE 0 END) as completedCount,
            MAX(t.create_time) as latest_create_time
        FROM amz_task_main t
        <where>
            <if test="storeName != null and storeName != ''">
                AND t.store_name = #{storeName}
            </if>
            <if test="sku != null and sku != ''">
                AND t.sku = #{sku}
            </if>
            <if test="asin != null and asin != ''">
                AND t.asin = #{asin}
            </if>
            <if test="marketplaceId != null and marketplaceId != ''">
                AND t.marketplace_id = #{marketplaceId}
            </if>
            <if test="metricType != null and metricType != ''">
                AND t.metric_type = #{metricType}
            </if>
        </where>
        GROUP BY 
            t.store_name, 
            t.sku
        ORDER BY
            latest_create_time DESC
    </select>

    <insert id="insertAmzTaskMain" parameterType="AmzTaskMain" useGeneratedKeys="true" keyProperty="taskId">
        insert into amz_task_main
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="taskName != null and taskName != ''">task_name,</if>
            <if test="taskCode != null">task_code,</if>
            <if test="storeName != null and storeName != ''">store_name,</if>
            <if test="sku != null and sku != ''">sku,</if>
            <if test="asin != null">asin,</if>
            <if test="marketplaceId != null">marketplace_id,</if>
            <if test="metricType != null and metricType != ''">metric_type,</if>
            <if test="targetLevel != null and targetLevel != ''">target_level,</if>
            <if test="targetValue != null">target_value,</if>
            <if test="currentValue != null">current_value,</if>
            <if test="startTime != null">start_time,</if>
            <if test="endTime != null">end_time,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="taskName != null and taskName != ''">#{taskName},</if>
            <if test="taskCode != null">#{taskCode},</if>
            <if test="storeName != null and storeName != ''">#{storeName},</if>
            <if test="sku != null and sku != ''">#{sku},</if>
            <if test="asin != null">#{asin},</if>
            <if test="marketplaceId != null">#{marketplaceId},</if>
            <if test="metricType != null and metricType != ''">#{metricType},</if>
            <if test="targetLevel != null and targetLevel != ''">#{targetLevel},</if>
            <if test="targetValue != null">#{targetValue},</if>
            <if test="currentValue != null">#{currentValue},</if>
            <if test="startTime != null">#{startTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateAmzTaskMain" parameterType="AmzTaskMain">
        update amz_task_main
        <trim prefix="SET" suffixOverrides=",">
            <if test="taskName != null and taskName != ''">task_name = #{taskName},</if>
            <if test="taskCode != null">task_code = #{taskCode},</if>
            <if test="storeName != null and storeName != ''">store_name = #{storeName},</if>
            <if test="sku != null and sku != ''">sku = #{sku},</if>
            <if test="asin != null">asin = #{asin},</if>
            <if test="marketplaceId != null">marketplace_id = #{marketplaceId},</if>
            <if test="metricType != null and metricType != ''">metric_type = #{metricType},</if>
            <if test="targetLevel != null and targetLevel != ''">target_level = #{targetLevel},</if>
            <if test="targetValue != null">target_value = #{targetValue},</if>
            <if test="currentValue != null">current_value = #{currentValue},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where task_id = #{taskId}
    </update>

    <delete id="deleteAmzTaskMainByTaskId" parameterType="Long">
        delete from amz_task_main where task_id = #{taskId}
    </delete>

    <delete id="deleteAmzTaskMainByTaskIds" parameterType="String">
        delete from amz_task_main where task_id in 
        <foreach item="taskId" collection="array" open="(" separator="," close=")">
            #{taskId}
        </foreach>
    </delete>
</mapper>