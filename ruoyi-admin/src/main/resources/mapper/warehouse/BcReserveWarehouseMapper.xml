            <if test="box3 != null">#{box3},</if>
            <if test="box4 != null">#{box4},</if>
            <if test="box5 != null">#{box5},</if>
            <if test="box6 != null">#{box6},</if>
            <if test="box7 != null">#{box7},</if>
            <if test="box8 != null">#{box8},</if>
            <if test="box9 != null">#{box9},</if>
            <if test="box10 != null">#{box10},</if>
            <if test="boxSize != null">#{boxSize},</if>
            <if test="weight != null">#{weight},</if>
         </trim>
    </insert>

    <update id="updateBcReserveWarehouse" parameterType="BcReserveWarehouse">
        update bc_reserve_warehouse
        <trim prefix="SET" suffixOverrides=",">
            <if test="stockId != null">stock_id = #{stockId},</if>
            <if test="stockWarehouse != null">stock_warehouse = #{stockWarehouse},</if>
            <if test="goodsId != null">goods_id = #{goodsId},</if>
            <if test="goodsNumber != null">goods_number = #{goodsNumber},</if>
            <if test="shopId != null">shop_id = #{shopId},</if>
            <if test="box1 != null">box1 = #{box1},</if>
            <if test="box2 != null">box2 = #{box2},</if>
            <if test="box3 != null">box3 = #{box3},</if>
            <if test="box4 != null">box4 = #{box4},</if>
            <if test="box5 != null">box5 = #{box5},</if>
            <if test="box6 != null">box6 = #{box6},</if>
            <if test="box7 != null">box7 = #{box7},</if>
            <if test="box8 != null">box8 = #{box8},</if>
            <if test="box9 != null">box9 = #{box9},</if>
            <if test="box10 != null">box10 = #{box10},</if>
            <if test="boxSize != null">box_size = #{boxSize},</if>
            <if test="weight != null">weight = #{weight},</if>
        </trim>
        where sku = #{sku}
    </update>

    <delete id="deleteBcReserveWarehouseBySku" parameterType="String">
        delete from bc_reserve_warehouse where sku = #{sku}
    </delete>

    <delete id="deleteBcReserveWarehouseBySkus" parameterType="String">
        delete from bc_reserve_warehouse where sku in 
        <foreach item="sku" collection="array" open="(" separator="," close=")">
            #{sku}
        </foreach>
    </delete>
</mapper>